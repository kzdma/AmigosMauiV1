<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AmigosMauiV1.FontsWorkout"
             Title="FontsWorkout">
    <VerticalStackLayout>
        <Label 
            FontSize="Large"
            Text="Welcome to Amigos!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
            WidthRequest="300"
            FontSize="Large"
            Text="This is an example of using custom font"
            FontFamily="BitcountInk"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Button 
            Text="&#xe87d;"
            WidthRequest="300"
            FontFamily="MaterialIcons"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>