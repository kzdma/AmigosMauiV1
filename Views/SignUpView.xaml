             x:Class="AmigosMauiV1.Views.SignUpView"        
             Title="SignUpView">


    <Grid RowDefinitions="1.5*,3*,1*">
        <VerticalStackLayout BackgroundColor="Bisque"/>


        <!--  User Image  -->
        <!--<StackLayout Margin="0,15,0,10" VerticalOptions="Center">
 
        </StackLayout>-->
        <VerticalStackLayout Grid.Row="1" BackgroundColor="BlueViolet">
