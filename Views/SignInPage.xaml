<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AmigosMauiV1.Views.SignInPage"
             Title="SignInPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="LightCyan"/>
            <GradientStop Offset="0.5" Color="#3a7bd5"/>
            <GradientStop Offset="1.0" Color="Purple"/>
        </LinearGradientBrush>
        
    </ContentPage.Background>
    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">
        <Border
            Padding="10"
            Stroke="#ccc"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">
            <Entry
                x:Name="UsernameEntry"
                Keyboard="Email"
                FontSize="18"
                Placeholder="Email"
                TextColor="Wheat"
                ReturnType="Go"/>
        </Border>
        <Border
            Padding="10"
            Stroke="#ccc"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">
            <Grid
                Padding="10"
                ColumnDefinitions="*,Auto"
                VerticalOptions="Center">
                <Entry
                    x:Name="PasswordEntry"
                    BackgroundColor="Transparent"
                    FontSize="18"
                    IsPassword="True"
                    Placeholder="סיסמה"
                    TextColor="Wheat"
                    VerticalOptions="Center"/>
                <Button
                    x:Name="TogglePassordButton"                   
                    Margin="5,0,0,0"
                    Padding="0"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    HorizontalOptions="End"
                    Text="&#xe8f5;"
                    FontFamily="MaterialIcons"
                    TextColor="White"
                    VerticalOptions="Center"
                    Clicked="OnSignInButtonClicked"/>
            </Grid>
        </Border>

        <!-- כפתור כניסה-->
        <Button
            CornerRadius="8"
            FontSize="18"
            HeightRequest="50"
            IsEnabled="False"
            Text="חיבור"
            TextColor="White"/>

        <!-- שגיאה-->
        <Label
            x:Name="errorLbl"
            FontSize="45"
            HorizontalTextAlignment="Center"
            IsVisible="False"
            Text="שגיאה"
            TextColor="Red"/>

    </VerticalStackLayout>
</ContentPage>